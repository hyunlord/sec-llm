*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
models/
checkpoints/
outputs/
data/
datasets/
runs/
*.arrow

# Logs -- raw stdout of env checks is packed by `make pack`, not committed
logs/
*.log

