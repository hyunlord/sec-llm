# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.uv/

# Raw corpus -- never committed. Manifests, pins and reports are.
# Raw corpus is excluded, but git cannot re-include a path inside an excluded
# DIRECTORY -- so exclude the contents (data/*) rather than the directory itself,
# which is what lets the negation below actually take effect.
data/*
# The hand-labelled calibration sample is evidence, not corpus: it is small, it
# is what lets anyone re-derive the threshold choice, and it is committed.
!data/labels/

# Model weights, datasets, checkpoints -- never committed
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
models/
checkpoints/
outputs/
# (raw corpus already handled by `data/*` above, which permits the
#  data/labels negation; a bare `data/` here would re-block it)
# NOTE: `datasets/` is the P3 source package and IS committed. Materialized
# JSONL lives under data/out/, which data/* already excludes.
runs/
*.arrow

# Logs -- raw stdout of env checks is packed by `make pack`, not committed
logs/
*.log

# Artifacts
p0-artifacts.zip

# OS / editor
.DS_Store
.idea/
.vscode/

# OMC / tooling scratch
.omc/
.omx/
.codegraph
